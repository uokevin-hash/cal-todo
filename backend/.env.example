# 백엔드 환경 변수. 이 파일을 복사해 값을 채운다(git 제외)
#   개발·운영 → backend/.env
#   테스트    → backend/.env.test (DATABASE_URL은 이름에 _test가 있는 DB여야 한다)
# 자세한 설명은 docs/백엔드설치및구동.md 3장

# 필수
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/cal_todo
# 32바이트 이상, 서로 다른 값. 만들기: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 영구 관리자가 없는 첫 기동 때만 필요(R-11)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# 선택
PORT=3000
# 프론트엔드 출처, 쉼표로 구분. 비우면 CORS 헤더 없음
CORS_ORIGINS=http://localhost:5173
# Refresh Token 쿠키 SameSite: strict(기본) | lax | none(다른 사이트 배포, HTTPS 필요)
COOKIE_SAME_SITE=strict
# production이면 쿠키 Secure + /api-docs 끔
NODE_ENV=
# Access Token 유효 시간(15m)
ACCESS_TOKEN_TTL=15m
# 채팅 이미지 최대 바이트(2097152 = 2MB)
CHAT_IMAGE_MAX_BYTES=2097152
